# Maintainer: Zehra Duymaz
pkgname=potter
pkgver=0.7.2
pkgrel=1
_ftxuiver=6.1.9
pkgdesc="Lightweight terminal Pomodoro timer with tasks, focus history and music"
arch=('x86_64' 'aarch64')
url="https://github.com/ZehraDuymaz/potter"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'tomlplusplus')
makedepends=('cmake' 'nlohmann-json')
optdepends=('mpv: music'
            'yt-dlp: YouTube search and links'
            'libnotify: desktop notifications')
# FTXUI isn't packaged for Arch, so it's downloaded here instead of by CMake.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "ftxui-$_ftxuiver.tar.gz::https://github.com/ArthurSonzogni/FTXUI/archive/refs/tags/v$_ftxuiver.tar.gz")
sha256sums=('0350b002621693d19dabc3ac9292211e1a3bd6790c72c04f2a29a71584422b5f'
            '45819c1e54914783d4a1ca5633885035d74146778a1f74e1213cdb7b76340e71')

build() {
  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DFETCHCONTENT_SOURCE_DIR_FTXUI="$srcdir/FTXUI-$_ftxuiver"
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
