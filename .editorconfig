# Basic editor settings, read by most editors: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces mean a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Written by makepkg, which uses tabs.
[.SRCINFO]
indent_style = tab
